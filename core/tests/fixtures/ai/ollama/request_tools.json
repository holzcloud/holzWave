{
  "model": "test-model",
  "messages": [
    {
      "role": "system",
      "content": "You are a terminal assistant."
    },
    {
      "role": "user",
      "content": "list files"
    },
    {
      "role": "assistant",
      "content": "Let me look.",
      "tool_calls": [
        {
          "function": {
            "name": "read_file",
            "arguments": {
              "path": "a.txt"
            }
          }
        },
        {
          "function": {
            "name": "list_dir",
            "arguments": {
              "path": "."
            }
          }
        }
      ]
    },
    {
      "role": "tool",
      "content": "alpha",
      "tool_name": "read_file"
    },
    {
      "role": "tool",
      "content": "[tool output not stored]",
      "tool_name": "list_dir"
    },
    {
      "role": "user",
      "content": "thanks"
    }
  ],
  "stream": true,
  "options": {
    "num_ctx": 16384,
    "num_predict": 256
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "read_file",
        "description": "Read a text file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "list_dir",
        "description": "List a directory.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    }
  ]
}
