{
  "model": "test-model",
  "messages": [
    {
      "role": "system",
      "content": "You are a terminal assistant."
    },
    {
      "role": "user",
      "content": "list files"
    },
    {
      "role": "assistant",
      "content": "Let me look.",
      "tool_calls": [
        {
          "id": "call_1",
          "type": "function",
          "function": {
            "name": "read_file",
            "arguments": "{\"path\":\"a.txt\"}"
          }
        },
        {
          "id": "call_2",
          "type": "function",
          "function": {
            "name": "list_dir",
            "arguments": "{\"path\":\".\"}"
          }
        }
      ]
    },
    {
      "role": "tool",
      "content": "alpha",
      "tool_call_id": "call_1"
    },
    {
      "role": "tool",
      "content": "[tool output not stored]",
      "tool_call_id": "call_2"
    },
    {
      "role": "user",
      "content": "thanks"
    }
  ],
  "stream": true,
  "stream_options": {
    "include_usage": true
  },
  "max_tokens": 256,
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "read_file",
        "description": "Read a text file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "list_dir",
        "description": "List a directory.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    }
  ]
}
