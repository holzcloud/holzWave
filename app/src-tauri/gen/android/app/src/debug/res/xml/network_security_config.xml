<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only. Cleartext is refused everywhere (the default of this target SDK) except to the emulator's alias of the
     host machine. A blanket allow would let any address be reached without TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
