{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "the commands of the app and the drag region, for the windows the app makes: main and window-<n>",
  "windows": [
    "main",
    "window-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-get-layout",
    "allow-start-pane",
    "allow-key",
    "allow-send-edit",
    "allow-text",
    "allow-paste",
    "allow-resize",
    "allow-scroll",
    "allow-scroll-to-bottom",
    "allow-request-full",
    "allow-select",
    "allow-selection-text",
    "allow-search",
    "allow-copy-mode",
    "allow-split",
    "allow-new-tab",
    "allow-new-workspace",
    "allow-close-pane",
    "allow-focus-pane",
    "allow-cycle-focus",
    "allow-select-tab",
    "allow-select-workspace",
    "allow-rename-pane",
    "allow-rename-tab",
    "allow-rename-workspace",
    "allow-move-pane",
    "allow-move-tab",
    "allow-move-tab-to-workspace",
    "allow-set-ratio",
    "allow-tear-off-pane",
    "allow-tear-off-tab",
    "allow-release-outside",
    "allow-attach-pane",
    "allow-attach-tab",
    "allow-window-ready",
    "allow-get-settings",
    "allow-set-setting",
    "allow-reset-setting",
    "allow-reload-settings",
    "allow-app-info",
    "allow-open-url",
    "allow-reveal-path",
    "allow-mouse",
    "allow-wheel"
  ]
}
